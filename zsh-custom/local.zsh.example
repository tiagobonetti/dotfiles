# local.zsh.example — copy to local.zsh and fill in real values.

# Example: machine-specific build flags
# export CMAKE_EXTRA_FLAGS="-DCMAKE_BUILD_TYPE=Debug"

# Example: build with a specific macOS SDK and deployment target.
# Use this when targeting an older macOS version than the one running locally.
# export SDKROOT="/Library/Developer/CommandLineTools/SDKs/MacOSX15.sdk"
# export MACOSX_DEPLOYMENT_TARGET="15.5"
