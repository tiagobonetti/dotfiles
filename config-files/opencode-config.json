{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v2/mcp",
        "disabled": false
      }
    }
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/lumicks/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.conan2/**", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/opencode/**", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/opencode/skills/**", "effect": "allow" },
    { "action": "atlassian_*", "resource": "*", "effect": "deny" }
  ],
  "agents": {
    "atlassian": {
      "description": "Use this agent for Jira and Confluence work.",
      "mode": "subagent",
      "permissions": [
        { "action": "atlassian_*", "resource": "*", "effect": "allow" }
      ]
    }
  }
}
